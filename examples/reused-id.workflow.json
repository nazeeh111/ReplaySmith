{
  "version": 1,
  "name": "Save a dispatch note",
  "description": "A local demonstration: change the note, save a draft, and verify its contents.",
  "inputs": {
    "note": {
      "default": "Send the field kit to Avery.",
      "description": "The note to save"
    }
  },
  "allowedOrigins": [
    "http://127.0.0.1:3333"
  ],
  "steps": [
    {
      "id": "open",
      "action": "navigate",
      "description": "Open the dispatch desk",
      "url": "http://127.0.0.1:3333/demo?variant=reused-id"
    },
    {
      "id": "note",
      "action": "fill",
      "description": "Write the dispatch note",
      "target": {
        "selectors": [
          "#note"
        ],
        "evidence": {
          "tag": "textarea",
          "role": "textbox",
          "label": "Dispatch note",
          "name": "Dispatch note",
          "context": "Dispatch desk"
        }
      },
      "value": "{{note}}"
    },
    {
      "id": "save",
      "action": "click",
      "description": "Save the draft",
      "target": {
        "selectors": [
          "#save"
        ],
        "evidence": {
          "tag": "button",
          "role": "button",
          "name": "Save draft",
          "text": "Save draft",
          "type": "button",
          "context": "Dispatch desk"
        }
      }
    },
    {
      "id": "verify",
      "action": "assert",
      "description": "Verify the saved note",
      "assertion": {
        "kind": "text",
        "target": {
          "selectors": [
            "#receipt"
          ],
          "evidence": {
            "tag": "output",
            "testId": "receipt"
          }
        },
        "value": "Draft saved: {{note}}"
      }
    }
  ]
}
